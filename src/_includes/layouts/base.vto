<!DOCTYPE html>
<html lang="{{ lang || metas.lang }}">
  <head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title || metas.title }}{{ if title && title != metas.title }} · {{ metas.site }}{{ /if }}</title>
<link rel="canonical" href="{{ url |> url(true) }}">
<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ metas.site }}">
<link rel="alternate" href="/feed.json" type="application/json" title="{{ metas.site }}">
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
{{ for theme of theme_colors }}
<meta name="theme-color" content="{{ theme.color }}" media="{{ theme.media }}">
{{ /for }}
<link rel="preload" href="/assets/fonts/familjen-grotesk-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/fonts.css">
<link rel="stylesheet" href="/style.css">
<script>
/* Resolve the theme before first paint. Kept inline and tiny on purpose: an
   external script here would arrive after the first frame and flash. The
   `no-js` class is the signal that nothing else has run yet — without JS the
   reveal animations must stay disabled. */
(function () {
  // Added unconditionally, before anything else, and removed again by main.js
  // once it has booted. It has to be here rather than in the runtime: if that
  // never arrives, `.no-js` is the only thing keeping the reveal animations
  // from leaving holes in the page.
  document.documentElement.classList.add('no-js');
  try {
    var m = localStorage.getItem('fs-theme');
    if (m === 'light' || m === 'dark') document.documentElement.setAttribute('data-theme', m);
  } catch (e) {
    // Storage disabled. The media query still resolves the system preference,
    // so there is nothing to recover and nothing to report.
  }
})();
</script>
{{ if extra_head?.length }}{{ extra_head.join("\n") }}{{ /if }}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Main">
      <div class="container nav__inner">
        <a class="logo" href="/" aria-label="{{ metas.site }} — home">
          <svg width="30" height="27" viewBox="0 0 44 40" aria-hidden="true">
            <polyline points="2,22 16,22 20,22 23,8 26,32 29,22 42,22"
              fill="none"
              stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
          <span>{{ metas.site }}</span>
        </a>
        <button class="nav__burger" data-nav-toggle aria-expanded="false"
          aria-controls="nav-links" aria-label="Menu">
          <svg width="17" height="12" viewBox="0 0 17 12" aria-hidden="true">
            <path d="M0 1h17M0 6h17M0 11h17" stroke="currentColor"
              stroke-width="1.4" />
          </svg>
        </button>
        <div class="nav__links" id="nav-links" data-nav-links>
      {{ for entry of search.pages("menu.visible=true", "menu.order") }}
        <a class="nav__link{{ if entry.url == url }} is-active{{ /if }}" href="{{ entry.url }}">{{ entry.menu.title || entry.title }}</a>
      {{ /for }}
      <a class="nav__link{{ if url.startsWith("/archive/") || url == "/archive/" }} is-active{{ /if }}" href="/archive/">Archive</a>
      {{ for link of menu_links }}
        <a class="nav__link" href="{{ link.href }}"{{ if link.target }} target="{{ link.target }}" rel="noopener"{{ /if }}>{{ link.text }}</a>
      {{ /for }}
      <div class="nav__actions">
        <button class="theme" data-theme-toggle data-mode="system">
          <span class="sr-only">Colour theme</span>
          <svg data-mode="system" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.6" /><path d="M12 3.4a8.6 8.6 0 0 1 0 17.2z" fill="currentColor" stroke="none" />
          </svg>
          <svg data-mode="light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7" />
          </svg>
          <svg data-mode="dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 13.5A8.2 8.2 0 1 1 10.5 4a6.6 6.6 0 0 0 9.5 9.5z" />
          </svg>
        </button>
        <a class="btn btn--ghost btn--sm" href="/feed.xml">Feed</a>
      </div>
    </div>
      </div>
    </nav>

    <main id="main">
{{ content }}
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer__grid">
      <div class="footer__col footer__brand-col">
        <a class="logo" href="/" aria-label="{{ metas.site }} — home">
          <svg width="28" height="25" viewBox="0 0 44 40" aria-hidden="true">
            <polyline points="2,22 16,22 20,22 23,8 26,32 29,22 42,22" fill="none"
              stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{{ metas.site }}</span>
        </a>
        <p class="footer__license">{{ footer_note }}</p>
      </div>
      {{ for column of footer_columns }}
        <div class="footer__col">
          <h2>{{ column.title }}</h2>
          {{ for link of column.links }}
            <a href="{{ link.href }}"{{ if link.href.startsWith("http") }} target="_blank" rel="noopener"{{ /if }}>{{ link.text }}</a>
          {{ /for }}
        </div>
      {{ /for }}
    </div>
        <div class="footer__bottom">
      <span>© {{ new Date().getFullYear() }} {{ metas.site }}</span>
      {{ if footer_quote }}<span>{{ footer_quote |> md(true) }}</span>{{ /if }}
    </div>
      </div>
    </footer>

    <script src="/js/main.js" type="module"></script>
  </body>
</html>
