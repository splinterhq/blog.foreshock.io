---
layout: layouts/base.vto
title: Home
---

<header class="container section">

  {{ if home.show_eyebrow }}
  <div class="eyebrow"><span class="idx">{{ home.eyebrow_index || "Blog" }}</span> {{ home.eyebrow }}</div>
  {{ /if }}
  <h1 class="display" style="max-width:26ch">{{ home.title }}</h1>
  <p class="lead" style="max-width:70ch;margin-top:24px">{{ home.lead }}</p>
  <!--
  <div class="btn-row" style="margin-top:32px">
    <a class="btn btn--primary btn--lg" href="/archive/">Read the archive <span class="arrow">→</span></a>
    <a class="btn btn--ghost btn--lg" href="/feed.xml">Subscribe by feed</a>
    <a class="btn btn--link" href="https://foreshock.io">The main site</a>
  </div>
  -->
  {{ if home.seismograph }}
    <div style="margin-top:40px;max-width:640px">
      <canvas data-seismograph height="110" aria-hidden="true" style="width:100%;height:110px"></canvas>
    </div>
  {{ /if }}
</header>

<section class="container section--tight">
  {{ include "templates/post-list.vto" {
    postslist: search.pages("type=post", "date=desc", 5),
    compact: true
  } }}
  <p style="margin-top:28px">
    <a class="btn btn--link" href="/archive/">{{ i18n.nav.all_posts }} <span class="arrow">→</span></a>
  </p>
</section>


